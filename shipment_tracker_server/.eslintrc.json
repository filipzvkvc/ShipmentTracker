{    
    "env": {        
        "commonjs": true,
        "es6": true,
        "node" : true       
        //"jest" : true
    },
    "globals": {
        "jest/globals" : true
    },
    "extends": ["eslint:recommended","node","plugin:node/recommended", "plugin:import/errors", "plugin:import/warnings", "plugin:jest/recommended"],    
    //"plugins": ["jest"],
    "parserOptions": {
        "ecmaVersion": 6,
        //"ecmaVersion": 2018,        
        "sourceType": "module"
    },
    "rules": {
        "no-unused-vars" : "warn",
        "no-console" : "off",
        "import/no-commonjs" : "off",
        "prefer-const" :"off",
        "no-else-return" : "off",
        "eqeqeq" : "warn",
        "dot-notation" : "off",
        "prefer-arrow-callback" : "off",
        "no-useless-constructor" : "off",
        "no-process-exit" : "off",        

        "no-lonely-if" : "warn",
        "arrow-body-style" : "off",
        "jest/no-done-callback" : "warn"
    }
    
}
